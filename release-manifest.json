{
  "schema_version": 1,
  "description": "Public source profile: Indian runtime, skills, dashboard and original synthetic tests. No Git history or captured provider payloads.",
  "include": [
    "README.md", "LICENSE", "NOTICE.md", "CONTRIBUTING.md", "SECURITY.md",
    "CHANGELOG.md", ".gitignore", ".dockerignore", ".env.example", "Makefile",
    "Dockerfile", "install_codex.py", "release-manifest.json",
    "india/*.py", "workflow/*.py", "trader-*/SKILL.md", "trader-*/*.py",
    "trader-team/agents/*.yaml", "trader-team/references/*.md",
    "codex-agents/*.toml", "config/*.example.json", "config/calendar.2026.json",
    "legacy/README.md", "legacy/trader-*/*.py", "legacy/trader-*/*.example.json",
    "dashboard/*.py", "dashboard/README.md", "dashboard/package.json", "dashboard/package-lock.json",
    "dashboard/index.html", "dashboard/vite.config.js", "dashboard/src/*.jsx", "dashboard/src/*.css",
    "docs/GETTING_STARTED.md", "docs/WORKFLOW.md", "docs/TEAM.md",
    "docs/RESEARCH.md", "docs/OPERATIONS.md", "docs/RELEASE.md",
    "scripts/build_release.py", "tests/_provider_fixtures.py", "tests/fixtures/README.md",
    ".github/workflows/tests.yml", ".github/ISSUE_TEMPLATE/*.yml", ".github/PULL_REQUEST_TEMPLATE.md"
  ],
  "tests": [
    "tests/test_dashboard.py", "tests/test_forecast.py", "tests/test_hardening.py",
    "tests/test_india.py", "tests/test_nse.py", "tests/test_repo.py", "tests/test_release.py",
    "tests/test_team.py", "tests/test_upstox.py", "tests/test_workflow.py", "tests/test_yahoo.py"
  ],
  "synthetic_fixtures": [
    "tests/fixtures/india/synthetic.csv",
    "tests/fixtures/india/workflow/disclosures.csv",
    "tests/fixtures/india/workflow/financials.json",
    "tests/fixtures/india/workflow/security-master.csv",
    "tests/fixtures/india/workflow/yahoo-DEMO.NS.xml"
  ]
}
